{
  "protocol": "1.0.0",
  "id": "com.example.scoped",
  "short": "scoped",
  "version": "0.1.0",
  "title": "Scoped",
  "description": "A plugin for the conformance runner's own tests of command and scope answers.",
  "publisher": { "id": "com.example", "key_id": "example-key-01", "name": "Example Publisher" },
  "commands": [{ "name": "draft", "args": "", "description": "Start a draft", "resolve": "scoped_resolve" }],
